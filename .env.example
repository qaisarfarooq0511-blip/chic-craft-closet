# Copy this file to .env and fill in your values.
# NEVER commit .env to git. Only .env.example is tracked.

# Supabase
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App
VITE_APP_URL=https://yaawun.com
VITE_ADMIN_URL=https://yaawun.com/admin

# Product images: Supabase Storage's public "product-images" bucket — no extra env vars
# needed, it's addressed through the Supabase client already configured above.
# Cloudinary was dropped for now; see docs/CHANGELOG.md if it comes back later.

# Payments (Razorpay — public key only, never put secret key in VITE_)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_here

# Mobile OTP auth — dev-only bypass, never true in production.
# When true, the frontend expects otp-request/otp-verify to accept "123456" for any
# phone number (matches the DEV_OTP_BYPASS Edge Function secret — keep both in sync).
VITE_DEV_OTP_BYPASS=true

# Server-side only (never prefix with VITE_)
# These go in Supabase Edge Function secrets, not in this file
# RAZORPAY_KEY_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# SUPABASE_JWT_SECRET=  # required by otp-verify to mint sessions — from Project Settings > API > JWT Settings
