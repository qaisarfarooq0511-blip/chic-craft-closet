# Copy this file to .env and fill in your values.
# NEVER commit .env to git. Only .env.example is tracked.

# Supabase
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App
VITE_APP_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5173/admin

# Image processing (Cloudinary)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=yaawun_products

# Payments (Razorpay — public key only, never put secret key in VITE_)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_here

# Server-side only (never prefix with VITE_)
# These go in Supabase Edge Function secrets, not in this file
# RAZORPAY_KEY_SECRET=
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
